{
  "manifest_version": 2,
  "name": "2U",
  "description": "Analyzes a website's Terms of Use while you browse and rates it via the ToS;DR API.",
  "version": "1.0",
  "browser_action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "background" : {
    "scripts" : ["background.js"]
  },
  "content_scripts" : [
    {
      "matches" : ["<all_urls>", "http://*/*", "https://*/*"],
      "css" : ["content.css"],
      "js" : ["jquery-2.2.2.min.js", "content.js"]
    }
  ],
  "web_accessible_resources" : ["fabbtn.html","popup.html"]
}
